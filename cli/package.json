{
	"name": "sitegeist",
	"version": "0.1.0",
	"description": "Bridge between coding harnesses (MCP, pi) and the sitegeist browser extension",
	"license": "AGPL-3.0",
	"type": "module",
	"bin": {
		"sitegeist": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-transform-types --no-warnings --test src/*.test.ts",
		"check": "npm run typecheck && npm test && npm run build",
		"prepublishOnly": "npm run build"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
